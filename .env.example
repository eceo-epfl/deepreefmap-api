# Copy to .env for local work outside docker compose. The compose stack in
# ../deepreefmap-ui sets all of this itself, so you do not need a .env to use it.

DATABASE_URL=postgresql://postgres:psql@localhost:5433/postgres
# Or, instead of DATABASE_URL:
# DB_USER=postgres
# DB_PASSWORD=psql
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=postgres

API_HOST=0.0.0.0
API_PORT=3000

# local | dev | stage | prod. Keycloak is mandatory in stage and prod: the server
# refuses to start without it.
DEPLOYMENT=local

# The web interface fetches these from /api/config/keycloak rather than baking them
# in, so one built bundle serves every deployment.
KEYCLOAK_URL=http://localhost:8280/
# Browser-facing Keycloak URL, when it differs from the one above (container networks).
# KEYCLOAK_BROWSER_URL=http://localhost:8280/
KEYCLOAK_REALM=deepreefmap
KEYCLOAK_CLIENT_ID=deepreefmap-ui-local

# Absolute base URL the desktop application should call. It is embedded in every
# connect code, so without it no new client can be enrolled.
PUBLIC_BASE_URL=http://localhost:3000/api

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:88

DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
REQUEST_TIMEOUT_SECONDS=60

# How long a connect code stays usable. Short: it is a bearer secret that travels
# through chat and email on its way to a laptop.
CONNECT_CODE_TTL_SECONDS=900

# Device-token validation cache. Short so revocation takes effect promptly.
TOKEN_CACHE_TTL_SECONDS=5

DISABLE_RATE_LIMITING=false
ENROL_RATE_LIMIT_BURST=5
ENROL_RATE_LIMIT_PERIOD_SECS=10

# Ceiling on a sync push body. Metadata only, so this is generous and still leaves
# no room to post footage through it.
SYNC_BODY_LIMIT_BYTES=16777216

RUST_LOG=info,deepreefmap_api=debug
