FROM rust:1.97.1-trixie

# bacon watches the mounted source and restarts the server; nextest runs the
# integration suite in the test-watcher service.
RUN cargo install bacon && cargo install --locked cargo-nextest

WORKDIR /app

# Only the manifests are copied. Source is volume-mounted at runtime, so a code
# change does not invalidate the dependency layer.
COPY Cargo.toml Cargo.lock ./
COPY migration/Cargo.toml migration/Cargo.toml

# Stub sources so cargo can resolve the workspace before the real ones are mounted.
RUN mkdir -p src && echo "fn main() {}" > src/main.rs && echo "" > src/lib.rs \
    && mkdir -p migration/src && echo "fn main() {}" > migration/src/main.rs \
    && echo "" > migration/src/lib.rs

RUN cargo fetch

ENTRYPOINT ["bacon", "--headless", "run"]
